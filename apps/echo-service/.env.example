# Copy thành .env để chạy local: cp .env.example .env
# echo-service tự nạp .env khi khởi động (process.loadEnvFile); biến môi trường thật luôn thắng,
# nên chạy instance thứ hai chỉ cần: PORT=4002 npm run start:dev

# Cổng TCP của microservice (lắng nghe 0.0.0.0). Cũng là cổng được đăng ký lên registry.
PORT=4001

# --- Service Registry (apps/service-discovery), do @org/service-discovery-client xử lý ---
# Bỏ trống REGISTRY_URL = không đăng ký (gateway phải dùng file discovery tĩnh).
REGISTRY_URL=http://localhost:8500
# Không bắt buộc. Mặc định: name trong package.json.
# SERVICE_NAME=echo
# Không bắt buộc. Mặc định: IPv4 đầu tiên không phải loopback. KHÔNG được là 0.0.0.0.
# Trong Docker nên đặt là tên service. Máy có VPN/nhiều card mạng nên đặt tay.
# SERVICE_ADVERTISE_HOST=127.0.0.1
# Không bắt buộc. Mặc định: <service>-<hostname>-<port>
# SERVICE_INSTANCE_ID=echo-1
# Chỉ cần khi registry đặt REGISTRY_TOKEN.
# REGISTRY_TOKEN=
