{
  "name": "@org/health",
  "version": "0.0.1",
  "description": "NestJS module: health check dùng chung (liveness/readiness) cho mọi service, kể cả microservice TCP không có HTTP",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
